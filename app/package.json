{
  "name": "the-rays-family-tree",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "description": "The Ray's — an interactive, JARVIS-style family tree of the House of Samarsingh.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:mac": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:public": "VITE_PUBLIC_VIEW=1 npm run build",
    "preview": "vite preview",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:mac:dir": "npm run build && electron-builder --mac --dir --publish never"
  },
  "build": {
    "appId": "com.familytree.desktop",
    "productName": "Family Tree",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.reference",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^9.0.10"
  }
}
